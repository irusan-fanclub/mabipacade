<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>true</IsPackable>
    <PackageId>Mabipacade.Core</PackageId>
    <Description>Mabinogi packet parser core: TCP reassembly, game packet framing, message body decoding, replay, recording, and NDJSON serialization.</Description>
  </PropertyGroup>
  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="PacketDotNet" Version="1.4.8" />
    <PackageReference Include="SharpPcap" Version="6.3.1" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Mabipacade.Core.Tests" />
    <InternalsVisibleTo Include="Mabipacade.Decoders" />
    <InternalsVisibleTo Include="Mabipacade.Decoders.Tests" />
  </ItemGroup>
</Project>
